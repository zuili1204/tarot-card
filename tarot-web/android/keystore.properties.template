# 复制为 keystore.properties 并填入真实值（keystore.properties 不进版本库）
# 生成密钥：
#   keytool -genkeypair -v -keystore tarot-release.keystore -alias tarot \
#           -keyalg RSA -keysize 2048 -validity 10000
# 密钥一旦丢失将无法为已安装用户升级覆盖，请单独备份 tarot-release.keystore
storeFile=tarot-release.keystore
storePassword=CHANGE_ME
keyAlias=tarot
keyPassword=CHANGE_ME
