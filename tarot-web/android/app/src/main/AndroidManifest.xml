<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限（11 Q22 / R1；2026-09-13 实测修复）：
         **必须有这一行**。此前认为"该权限由 capacitor-android 库经 manifest 合并引入"，
         实测不成立——Capacitor 8.5.1 的库已不再声明它，导致 APK 完全没有 INTERNET 权限，
         表现就是"应用能开但任何联网请求都失败"（AI 测试连接报"连不上这个地址"）。
         使用约束不变：AI 默认关闭、不配置即零请求，只有用户主动点「生成」时才向
         用户自己配置的服务发一次请求。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- 网络权限（11 Q22 / R1，2026-09-13 修订）：
         原计划"真机验证后彻底移除 INTERNET"（09 §7-6），因 AI 深度解读（S5/BYOK）需要联网而取消。
         现状与约束：
         1. app 侧本身从不主动发起请求；AI 功能**默认关闭**，未配置时零网络请求；
         2. 只有用户在设置里填了自己的接口地址与密钥、并在结果页主动点「生成」时，
            才会向**用户自己指定的服务**发一次请求；
         3. 权限本身由 capacitor-android 库经 manifest 合并引入，不是本应用声明的。
         若要恢复纯离线，把 AI 功能整体下架即可（设置页开关默认关，不发请求）。 -->

    <!-- VIBRATE 由 @capacitor/haptics 通过 manifest 合并自动引入（触觉反馈，09 Q10） -->
</manifest>
