<?xml version="1.0" encoding="utf-8"?>
<!--
  明文流量策略（11 §4.2 的 http 例外落地）：
  默认 **禁止** 明文 http（与 Android 9+ 默认一致，且满足上架要求）；
  仅对"本机地址"放行明文，覆盖用户在本机/模拟器上自建 Ollama、LM Studio 的场景
  （Ollama 默认 http://localhost:11434，不放行的话 Android 会直接掐断，报错像是"连不上"）。

  注意：局域网 IP（192.168.x.x 等）无法在这里按网段通配，因此局域网自建服务仍建议
  用 https 或反向代理；这一点在设置页说明文案里已提示。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Android 模拟器访问宿主机的固定别名 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
